# Copy this file to .env for local dev and Docker Compose builds.
# These are required only for Google Drive export.

# Google OAuth 2.0 Client ID for a Web application.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google API key used by Google Picker.
VITE_GOOGLE_API_KEY=your-google-api-key
